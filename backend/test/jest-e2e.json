{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "babel-jest",
      { "presets": [["@babel/preset-env", { "targets": { "node": "current" } }]] }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!(@noble)/)"],
  "testTimeout": 30000
}
